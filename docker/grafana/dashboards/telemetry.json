        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "blue", "value": null }] } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "telemetry_readings_stored_total",
          "legendFormat": "total",
          "refId": "A"
